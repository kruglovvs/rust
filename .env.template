# Committed defaults for the firmware build.
#
# WIFI_SSID / WIFI_PASSWORD are embedded at build time (firmware/build.rs).
WIFI_SSID=
WIFI_PASSWORD=

# Capture geometry. The DVP source only accepts these pairs; anything else
# silently falls back to QVGA:
#   320x240, 480x320, 640x480, 1024x768, 1280x720, 1920x1080
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=10

# Sensor JPEG quality, 0-63 (lower is better quality and bigger frames).
VIDEO_JPEG_QUALITY=12

# Audio: AAC-LC. G.711 would be fixed at 8000 Hz / 64 kb/s.
AUDIO_SAMPLE_RATE=48000
AUDIO_BITRATE=64000
