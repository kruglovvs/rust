# Board: Seeed XIAO ESP32S3 Sense — ESP32-S3R8, 8 MiB OCTAL PSRAM (schematic U1).
# Requires CONFIG_SPIRAM_MODE_OCT + CONFIG_SPIRAM_SPEED_80M; quad-mode settings will not work.
# GPIO21 is SD chip-select — NEVER drive it as an LED while the SD card is mounted.

# PSRAM: octal mode, 80 MHz, malloc-capable
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# XIAO ESP32S3 Sense has 8 MiB onboard flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# LwIP socket table (bug-mindmap B1/B3).
#
# Default LWIP_MAX_SOCKETS is 10. The Wi-Fi event loop, mDNS, the artifact
# HTTP server, and SNTP have already claimed entries by the time the RTSP
# listener binds, so raise it to 16 to leave headroom for the listener and
# per-connection sockets. The measured RTSP failure turned out to be a
# pthread stack allocation (B2), not this limit, but the headroom is still
# required and cheap.
#
# LWIP_MAX_LISTENING_TCP exists in components/lwip/Kconfig (range 1..1024)
# and already defaults to 16 in this IDF; it is set explicitly so a future
# toolchain default change cannot drop it below the RTSP listener.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_LISTENING_TCP=16

# Test headroom: stock 3584 overflows libtest's main; per-test threads need headroom.
#
# Todo 23: libtest spawns one pthread per #[test]. `libtest` never sets
# pthread_attr_setstacksize, so every test thread inherits
# CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT — that value, not
# CONFIG_ESP_MAIN_TASK_STACK_SIZE, is what bounds a test body. At 8192 the
# teardown path (std::rt::thread_cleanup -> vTaskSwitchContext ->
# vApplicationStackOverflowHook) overflowed and reset the chip, which is why
# the run never reached a `test result:` line. 32 KiB per thread keeps two
# concurrent test threads (~64 KiB) inside the 321 KiB of internal SRAM and
# covers the heaviest frames: AviMuxer::new and the half-band decimator both
# build multi-kilobyte locals on the stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768

# Task-watchdog budget: 30 s, not the 5 s default.
#
# libtest's main thread prints every test name and result over the 115200-baud
# console, and each write holds CPU0 while the UART drains. For a suite of this
# size that starves IDLE0 — the task the task watchdog actually watches — for
# longer than 5 s, so the run dies with "Task watchdog got triggered" partway
# through instead of reaching a `test result:` line. The starvation is an
# artefact of console bandwidth, not of any test hanging, and raising the
# budget preserves hang detection (a real deadlock still trips it, and
# scripts/run-device-tests.sh independently fails a run after 60 s of silence).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# FAT LFN on heap; camera DMA straight into PSRAM (frees ~30-64 KB internal SRAM)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_CAMERA_PSRAM_DMA=y

# The camera component uses the legacy I2C driver; ESP-IDF also links the new
# I2C driver through the HAL dependency graph. No new-driver bus is instantiated
# by this firmware. Skip the constructor-only coexistence abort so legacy camera
# SCCB can initialize; any real simultaneous use remains unsupported.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# Heap poisoning (Todo 23 corruption proof).
#
# Two findings are baked into this file's history and must not be undone:
#
# 1. `esp-idf-sys` registers `rerun-if-changed=<workspace>/sdkconfig.defaults`
#    and resolves `esp_idf_sdkconfig_defaults = ["sdkconfig.defaults"]` against
#    the WORKSPACE directory. Since firmware/ is its own workspace, this file
#    is that path: do not edit a copy elsewhere and expect it to be used.
#
# 2. Comprehensive poisoning poisons every alloc/free. It is the correct setting
#    for the Todo 23 corruption proof but makes the allocator slow enough to
#    risk the runner's 60 s idle watchdog on a long suite, so it is OFF for the
#    normal gate. Re-enable BOTH lines together for the corruption pass:
#      CONFIG_HEAP_POISONING_COMPREHENSIVE=y
#      CONFIG_HEAP_POISONING_DISABLED=n
#    The TLSF `block_locate_free` assert that originally exposed the corruption
#    is ESP-IDF's own allocator consistency check and fires with poisoning off,
#    so a clean run with poisoning disabled is still real evidence.
CONFIG_HEAP_POISONING_DISABLED=y

# ESP-ADF/GMF media pipeline (esp_capture_service / esp_rtsp_service /
# esp_muxer_service). Only the AVI muxer is needed for SD recording; every
# other container in esp_muxer is compiled out to keep the image small.
# Symbol names come from esp_muxer/Kconfig (CONFIG_ESP_MUXER_<TYPE>_SUPPORT).
CONFIG_ESP_MUXER_AVI_SUPPORT=y
CONFIG_ESP_MUXER_MP4_SUPPORT=n
CONFIG_ESP_MUXER_TS_SUPPORT=n
CONFIG_ESP_MUXER_OGG_SUPPORT=n
CONFIG_ESP_MUXER_WAV_SUPPORT=n
CONFIG_ESP_MUXER_FLV_SUPPORT=n
CONFIG_ESP_MUXER_CAF_SUPPORT=n

# MCP tooling is not used by this firmware. The per-service switches depend
# on the global ESP_MCP_ENABLE (esp_service/Kconfig, default y); turning the
# global off drops the MCP server/transport and the service tool schemas.
CONFIG_ESP_MUXER_SERVICE_MCP_ENABLE=n
CONFIG_ESP_RTSP_SERVICE_MCP_ENABLE=n
CONFIG_ESP_MCP_ENABLE=n

# Audio and video capture stay enabled: the pipeline is DVP camera MJPEG +
# mic G711U. Do not set CONFIG_ESP_CAPTURE_ENABLE_AUDIO/VIDEO=n.

# The ADF/GMF pipeline links ~3 MB of text+data, which does not fit the stock
# 1 MB factory slot (partitions_singleapp.csv). Use a 4 MB factory app in the
# 8 MB flash. esp-idf-sys builds from a generated CMake source dir, so IDF's
# PROJECT_DIR is that dir, not the workspace; the Kconfig help explicitly
# allows an absolute CSV path, which is required here.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/workspaces/rust/firmware/partitions.csv"

# RTSP/media timing and UDP pool parity with Espressif's own example.
#
# The RTSP example requires a 1 kHz tick; with the 100 Hz default the
# esp_rtsp server task busy-spins and can starve IDLE0.
# Track these values against the vendor example:
# managed_components/espressif__esp_rtsp_service/examples/rtsp_service/sdkconfig.defaults
CONFIG_FREERTOS_HZ=1000
# RTP/UDP sockets per the vendor example (RTP + RTCP per track, per session).
CONFIG_LWIP_MAX_UDP_PCBS=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
# The esp_rtsp server task polls its listening socket; the vendor example
# disables the task watchdog for the same reason.
CONFIG_ESP_TASK_WDT_EN=n
