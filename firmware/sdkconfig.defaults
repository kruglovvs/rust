# Board: Seeed XIAO ESP32S3 Sense — ESP32-S3R8, 8 MiB OCTAL PSRAM (schematic U1).
# Requires CONFIG_SPIRAM_MODE_OCT + CONFIG_SPIRAM_SPEED_80M; quad-mode settings will not work.
# GPIO21 is SD chip-select — NEVER drive it as an LED while the SD card is mounted.

# PSRAM: octal mode, 80 MHz, malloc-capable
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Test headroom: stock 3584 overflows libtest's main; per-test threads need 8 KiB
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# FAT LFN on heap; camera DMA straight into PSRAM (frees ~30-64 KB internal SRAM)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_CAMERA_PSRAM_DMA=y
