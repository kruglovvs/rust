{
  "rust-analyzer.linkedProjects": [
    "firmware/Cargo.toml",
    "harness/Cargo.toml"
  ],
  "rust-analyzer.cargo.allTargets": true,
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.testExplorer": true,
  "cmake.sourceDirectory": "/workspaces/rust/firmware/gmf-deps",
