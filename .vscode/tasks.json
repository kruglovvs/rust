{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP32-S3: Build firmware",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "exec env -i HOME=/home/esp PATH=/home/esp/.cargo/bin:/usr/local/bin:/usr/bin:/bin RUSTUP_HOME=/home/esp/.rustup CARGO_HOME=/home/esp/.cargo IDF_PATH=/opt/esp/idf IDF_TOOLS_PATH=/opt/esp/idf-tools RUSTUP_TOOLCHAIN=esp '${workspaceFolder}/scripts/build-firmware.sh'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP32-S3: Flash firmware over USB-JTAG",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/flash-debug-jtag.sh"
      ],
      "options": {
        "env": {
          "IDF_PATH": "/opt/esp/idf",
          "IDF_TOOLS_PATH": "/opt/esp/idf-tools"
        },
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": "ESP32-S3: Build firmware",
      "dependsOrder": "sequence"
    },
    {
      "label": "ESP32-S3: Run all on-device tests",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run-device-tests.sh",
        "--timeout-seconds",
        "300"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "ESP32-S3: Stream quality (60 s, 640x480)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/harness/stream_quality.sh",
        "--seconds",
        "60",
        "--width",
        "640",
        "--height",
        "480"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "ESP32-S3: Host harness tests",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "cd '${workspaceFolder}/harness' && cargo test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
